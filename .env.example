# Generate a strong secret, e.g. openssl rand -hex 32
EDUBRIDGE_API_KEY=replace-with-a-long-random-secret
# Comma-separated trusted origins. Keep empty until a server-side integration is deployed.
EDUBRIDGE_CORS_ORIGINS=

# Google AI Studio Gemini API key (keep secret; never expose in frontend variables)
GEMINI_API_KEY=replace-with-your-gemini-api-key
